<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/lexus_theme">

        <meta-data android:name="mediatype" android:value="audio" />
        <meta-data android:name="app_intent" android:value="com.autoai.media.qqmusic.home.ui.MainActivity" />

        <activity
            android:name=".home.ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.autoai.media.qqmusic.activity.MediaActivity"
            android:exported="false" />
        <service
            android:name="com.autoai.media.qqmusic.service.MusicBrowserService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
        <activity
            android:name="com.autoai.media.qqmusic.activity.PlaybackActivity"
            android:exported="false" />
    </application>

</manifest>
